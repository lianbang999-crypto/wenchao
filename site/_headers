# 全站安全响应头。站点纯静态、无 eval、无外域请求（AI 走同源 /api/ai），
# 故 connect-src/font-src/object-src 等一律收到最紧。
#
# script-src 为何留 'unsafe-inline'：每页两段 <script type="application/ld+json">
# 结构化数据（Article/BreadcrumbList/Book 图谱）会被严格 script-src 判为内联脚本拦下，
# 每页刷两条控制台报错。它们各页内容不同，2565 页没法逐个下 hash。
# 站内没有可执行的内联脚本，AI 回答经 ai-core.js 的 esc() 转义后才入 DOM，
# 没有 HTML 注入面——用整套 SEO 结构化数据换这一条的严格度不划算。
#
# 注意：若把 config.js 的 aiEndpoint 改成跨域 workers.dev 地址，须同步放开 connect-src。
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'

/config.js
  Cache-Control: no-store

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/a/*
  Cache-Control: no-cache

/v/*
  Cache-Control: no-cache

/t/*
  Cache-Control: no-cache

/ying/
  Cache-Control: no-cache

/ask/
  Cache-Control: no-cache

/img/*
  Cache-Control: public, max-age=2592000, immutable

# 目录与篇 JSON 随内容重建而变，且前端是按 no-cache 取的：显式声明一下，
# 保证浏览器留着副本走 ETag 协商（304），而不是落到启发式缓存或每次全量重下。
/data/*
  Cache-Control: no-cache

# css/js 全部经 ?v= 版本串引用（构建脚本统一注入），内容变则版本变，可放心长缓存。
# 字体切片文件名即内容标识（Google/字体包切片命名稳定），同样不可变。
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/font/*
  Cache-Control: public, max-age=31536000, immutable

# 例外：无版本串直引的文件不能 immutable——
# ai-core.js 被 app.js 以裸 import './ai-core.js' 引入；sw.js 是 SW 脚本本体。
/js/ai-core.js
  Cache-Control: no-cache

/js/qrcode.js
  Cache-Control: public, max-age=2592000

/sw.js
  Cache-Control: no-cache

/sitemap.xml
  Cache-Control: no-cache

/robots.txt
  Cache-Control: no-cache

# TWA 数字资产链接：Chrome 安装/打开 APP 时校验，须始终最新（Play 上架后要补 Play 签名指纹）
/.well-known/assetlinks.json
  Cache-Control: no-cache
  Content-Type: application/json

# 安卓安装包：文件名带版本号即内容标识，可长缓存；显式声明 MIME 与下载文件名，
# 免得个别浏览器把它当未知类型在页内打开或存成 .zip
/app/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment
  Cache-Control: public, max-age=31536000, immutable
