<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider 对外开放的目录白名单。
    只需要一处：下载好的新版安装包放在 cacheDir/apk/，交给系统安装器读取。
    （原先的 twa_splash/ 是 TWA 传启动屏图用的，已随外壳一起去掉。）
-->
<paths>
    <cache-path path="apk/" name="apk" />
    <!-- 分享卡图片：先落到 cacheDir/share/，再经 FileProvider 交给微信等接收方 -->
    <cache-path path="share/" name="share" />
</paths>
